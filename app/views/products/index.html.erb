<% flash.each do |type, msg| %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <%= msg %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% end %>

<div class="d-flex justify-content-between mb-4">
  <%= form_with url: products_path, method: :get, class: "d-flex" do %>
    <div class="input-group">
      <%= text_field_tag :query, params[:query], placeholder: "Search", class: "form-control" %>
      <%= submit_tag "Search", class: "btn btn-outline-success" %>
    </div>
  <% end %>

  <%= link_to new_product_path, class: "btn btn-success" do %>
    <i class="bi bi-plus"></i>
    <span>Novo Produto</span>
  <% end%>
</div>

<div class="table-responsive">
  <table class="table table-striped table-bordered align-middle">
    <thead class="text-center">
      <tr>
        <th scope="col">ID</th>
        <th scope="col">Nome</th>
        <th scope="col">Descrição</th>
        <th scope="col">Marcar</th>
        <th scope="col">Categoria</th>
        <th scope="col" class="w-25">Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @products.each do |product| %>
        <tr>
          <th scope="row"><%= product.id %></th>
          <td><%= product.title %></td>
          <td><%= product.description %></td>
          <td><%= product.brand.name %></td>
          <td><%= product.category.name %></td>
          <td class="d-flex justify-content-center gap-2">
            <%= link_to product_path(product), class:"btn btn-outline-info btn-sm" do %>
              <i class="bi bi-eye"></i>
            <% end %>

            <%= link_to edit_product_path(product), class:"btn btn-outline-warning btn-sm" do %>
              <i class="bi bi-pencil"></i>
            <% end %>

            <%= link_to product_path(product), 
                        data: { turbo_method: :delete, confirm: "Are you sure?" }, 
                        class:"btn btn-outline-danger btn-sm" do %>
              <i class="bi bi-trash"></i>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <div class="pag-bar mt-2 mb-2 d-flex justify-content-center">
    <%== pagy_bootstrap_nav(@pagy) %>
  </div>
</div>

