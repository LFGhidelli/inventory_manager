<% flash.each do |type, msg| %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <%= msg %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% end %>

<div class="row align-items-center mb-4 justify-content-between">
  <div class="col-md-6">
    <%= form_with url: products_path, method: :get, class: "d-flex" do %>
      <div class="input-group">
        <%= text_field_tag :query, params[:query], placeholder: "Buscar produto...", class: "form-control" %>
        <%= submit_tag "Buscar", class: "btn btn-outline-success" %>
      </div>
    <% end %>

    <%= form_with url: products_path, method: :get, class: "d-flex" do %>
      <div class="input-group">
        <%= text_field_tag :number_query, params[:number_query], placeholder: "Número de série", class: "form-control" %>
        <%= submit_tag "Buscar", class: "btn btn-outline-success" %>
      </div>
    <% end %>
  </div>

  <% if current_user.admin? %>
    <div class="col-md-3 text-md-end mt-2 mt-md-0">
      <%= link_to new_product_path, class: "btn btn-success w-100 w-md-auto" do %>
        <i class="bi bi-plus"></i>
        <span>Novo Produto</span>
      <% end %>
    </div>
  <% end %>
</div>

<div class="row mb-4">
  <div class="col-md-6">
    <%= form_with url: products_path, method: :get, class: "row g-2" do |f| %>
      <div class="col-md-4">
        <%= f.select :brand_query, Brand.all.map { |brand| [brand.name, brand.id] },
              { prompt: "Marca" }, { class: "form-select" } %>
      </div>
      <div class="col-md-4">
        <%= f.select :category_query, Category.all.map { |category| [category.name, category.id] },
              { prompt: "Categoria" }, { class: "form-select" } %>
      </div>
      <div class="col-md-4">
        <%= submit_tag "Filtrar", class: "btn btn-outline-success w-100" %>
      </div>
    <% end %>
  </div>
</div>


<div class="table-responsive">
  <table class="table table-striped table-bordered align-middle">
    <thead class="text-center">
      <tr>
        <th scope="col">ID</th>
        <th scope="col">Título</th>
        <th scope="col">Categoria</th>
        <th scope="col">Marca</th>
        <th scope="col">Preço de custo</th>
        <th scope="col">Preço de venda</th>
        <th scope="col">Número de série</th>
        <th scope="col">Quantidade</th>
        <th scope="col" class="">Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @products.each do |product| %>
        <tr>
          <th scope="row"><%= product.id %></th>
          <td><%= product.title %></td>
          <td><%= product.category.name %></td>
          <td><%= product.brand.name %></td>
          <td><%= product.cost_price %></td>
          <td><%= product.selling_price %></td>
          <td><%= product.serie_number %></td>
          <td><%= product.quantity %></td>
          <td class="d-flex justify-content-center gap-2">
            <%= link_to product_path(product), class:"btn btn-outline-info btn-sm" do %>
              <i class="bi bi-eye"></i>
            <% end %>

            <% if current_user.admin? %>
              <%= link_to edit_product_path(product), class:"btn btn-outline-warning btn-sm" do %>
                <i class="bi bi-pencil"></i>
              <% end %>

              <%= link_to product_path(product), 
                          data: { turbo_method: :delete, confirm: "Are you sure?" }, 
                          class:"btn btn-outline-danger btn-sm" do %>
                <i class="bi bi-trash"></i>
              <% end %>
            <% end %>            
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <div class="pag-bar mt-2 mb-2 d-flex justify-content-center">
    <%== pagy_bootstrap_nav(@pagy) %>
  </div>
</div>

