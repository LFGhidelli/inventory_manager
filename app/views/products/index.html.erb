<% content_for :page_title, "Produtos" %>

<div class="space-y-6 animate-fade-in">
  <!-- Header Section -->
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-blue-400">
        Produtos
      </h1>
      <p class="mt-1 text-gray-400">Gerencie seu inventário de produtos</p>
    </div>
    <% if current_user.admin? %>
      <%= link_to new_product_path, class: "inline-flex items-center px-6 py-3 bg-gradient-to-r from-purple-600 to-blue-600 hover:from-purple-700 hover:to-blue-700 text-white font-medium rounded-lg shadow-lg shadow-purple-500/30 transition-all duration-300 hover:scale-105" do %>
        <i class="bi bi-plus-circle mr-2"></i>
        Novo Produto
      <% end %>
    <% end %>
  </div>

  <!-- Search and Filters -->
  <div class="bg-gray-800/50 backdrop-blur-xl rounded-xl border border-gray-700/50 p-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
      <!-- Search by Name -->
      <div>
        <%= form_with url: products_path, method: :get, class: "flex gap-2" do %>
          <div class="flex-1">
            <%= text_field_tag :query, params[:query], placeholder: "Buscar produto...", class: "w-full px-4 py-3 bg-gray-900/50 border border-gray-700 rounded-lg text-gray-100 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all" %>
          </div>
          <%= submit_tag "Buscar", class: "px-6 py-3 bg-purple-600 hover:bg-purple-700 text-white font-medium rounded-lg transition-colors" %>
        <% end %>
      </div>

      <!-- Search by Serial Number -->
      <div>
        <%= form_with url: products_path, method: :get, class: "flex gap-2" do %>
          <div class="flex-1">
            <%= text_field_tag :number_query, params[:number_query], placeholder: "Número de série", class: "w-full px-4 py-3 bg-gray-900/50 border border-gray-700 rounded-lg text-gray-100 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all" %>
          </div>
          <%= submit_tag "Buscar", class: "px-6 py-3 bg-purple-600 hover:bg-purple-700 text-white font-medium rounded-lg transition-colors" %>
        <% end %>
      </div>
    </div>

    <!-- Filters -->
    <div class="mt-4">
      <%= form_with url: products_path, method: :get, class: "grid grid-cols-1 sm:grid-cols-3 gap-4" do |f| %>
        <div>
          <%= f.select :brand_query, Brand.all.map { |brand| [brand.name, brand.id] },
                { prompt: "Todas as Marcas" },
                { class: "w-full px-4 py-3 bg-gray-900/50 border border-gray-700 rounded-lg text-gray-100 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all" } %>
        </div>
        <div>
          <%= f.select :category_query, Category.all.map { |category| [category.name, category.id] },
                { prompt: "Todas as Categorias" },
                { class: "w-full px-4 py-3 bg-gray-900/50 border border-gray-700 rounded-lg text-gray-100 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all" } %>
        </div>
        <div>
          <%= submit_tag "Filtrar", class: "w-full px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Products Table -->
  <div class="bg-gray-800/50 backdrop-blur-xl rounded-xl border border-gray-700/50 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="bg-gradient-to-r from-purple-600/20 to-blue-600/20 border-b border-gray-700/50">
            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-300 uppercase tracking-wider">ID</th>
            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-300 uppercase tracking-wider">Título</th>
            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-300 uppercase tracking-wider">Categoria</th>
            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-300 uppercase tracking-wider">Marca</th>
            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-300 uppercase tracking-wider">Preço Custo</th>
            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-300 uppercase tracking-wider">Preço Venda</th>
            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-300 uppercase tracking-wider">N° Série</th>
            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-300 uppercase tracking-wider">Quantidade</th>
            <th class="px-6 py-4 text-center text-xs font-semibold text-gray-300 uppercase tracking-wider">Ações</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-700/50">
          <% @products.each do |product| %>
            <tr class="hover:bg-gray-700/30 transition-colors">
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-300"><%= product.id %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-white"><%= product.title %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-300"><%= product.category.name %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-300"><%= product.brand.nil? ? "N/A" : product.brand.name %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-300"><%= number_to_currency(product.cost_price, unit: "R$") %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-green-400 font-medium"><%= number_to_currency(product.selling_price, unit: "R$") %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-400 font-mono text-xs"><%= product.serie_number %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm">
                <span class="px-3 py-1 rounded-full text-xs font-medium <%= product.quantity > 10 ? 'bg-green-500/20 text-green-400' : product.quantity > 0 ? 'bg-yellow-500/20 text-yellow-400' : 'bg-red-500/20 text-red-400' %>">
                  <%= product.quantity %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-center text-sm">
                <div class="flex items-center justify-center gap-2">
                  <%= link_to product_path(product), class: "p-2 bg-blue-600/20 hover:bg-blue-600/40 text-blue-400 rounded-lg transition-colors" do %>
                    <i class="bi bi-eye"></i>
                  <% end %>

                  <% if current_user.admin? %>
                    <%= link_to edit_product_path(product), class: "p-2 bg-yellow-600/20 hover:bg-yellow-600/40 text-yellow-400 rounded-lg transition-colors" do %>
                      <i class="bi bi-pencil"></i>
                    <% end %>

                    <%= link_to product_path(product),
                                data: { turbo_method: :delete, turbo_confirm: "Tem certeza que deseja excluir este produto?" },
                                class: "p-2 bg-red-600/20 hover:bg-red-600/40 text-red-400 rounded-lg transition-colors" do %>
                      <i class="bi bi-trash"></i>
                    <% end %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <div class="px-6 py-4 border-t border-gray-700/50">
      <div class="flex items-center justify-center">
        <%== pagy_tailwind_nav(@pagy) %>
      </div>
    </div>
  </div>
</div>

<style>
  /* Custom pagination styling */
  .pagination {
    @apply flex gap-2;
  }
  .page-item .page-link {
    @apply px-4 py-2 bg-gray-700/50 text-gray-300 rounded-lg border border-gray-600 hover:bg-purple-600 hover:text-white hover:border-purple-600 transition-all;
  }
  .page-item.active .page-link {
    @apply bg-gradient-to-r from-purple-600 to-blue-600 text-white border-transparent;
  }
  .page-item.disabled .page-link {
    @apply opacity-50 cursor-not-allowed hover:bg-gray-700/50 hover:text-gray-300;
  }
</style>
