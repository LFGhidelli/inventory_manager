<% content_for :page_title, "Editar Produto" %>

<div class="max-w-3xl mx-auto space-y-6 animate-fade-in">
  <!-- Back Button -->
  <div>
    <%= link_to products_path, class: "inline-flex items-center text-gray-400 hover:text-white transition-colors" do %>
      <i class="bi bi-arrow-left mr-2"></i>
      Voltar para lista
    <% end %>
  </div>

  <!-- Form Card -->
  <div class="bg-gray-800/50 backdrop-blur-xl rounded-xl border border-gray-700/50 overflow-hidden">
    <!-- Header -->
    <div class="bg-gradient-to-r from-yellow-600/20 to-orange-600/20 px-8 py-6 border-b border-gray-700/50">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-lg bg-gradient-to-br from-yellow-500 to-orange-600 flex items-center justify-center shadow-lg shadow-yellow-500/30">
          <i class="bi bi-pencil text-white text-xl"></i>
        </div>
        <div>
          <h1 class="text-2xl font-bold text-white">Editar Produto</h1>
          <p class="text-sm text-gray-400 mt-1">Atualize as informações do produto</p>
        </div>
      </div>
    </div>

    <!-- Form -->
    <div class="p-8">
      <%= simple_form_for @product do |f| %>
        <%= f.error_notification %>

        <div class="space-y-6">
          <!-- Title -->
          <div>
            <%= f.label :title, "Título", class: "block text-sm font-medium text-gray-300 mb-2" %>
            <%= f.input_field :title,
                  class: "w-full px-4 py-3 bg-gray-900/50 border border-gray-700 rounded-lg text-gray-100 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:border-transparent transition-all",
                  placeholder: "Nome do produto" %>
            <%= f.error :title, class: "mt-1 text-sm text-red-400" %>
          </div>

          <!-- Description -->
          <div>
            <%= f.label :description, "Descrição", class: "block text-sm font-medium text-gray-300 mb-2" %>
            <%= f.input_field :description,
                  as: :text,
                  class: "w-full px-4 py-3 bg-gray-900/50 border border-gray-700 rounded-lg text-gray-100 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:border-transparent transition-all",
                  rows: 4,
                  placeholder: "Descreva o produto..." %>
            <%= f.error :description, class: "mt-1 text-sm text-red-400" %>
          </div>

          <!-- Grid: Brand and Category -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <%= f.label :brand, "Marca", class: "block text-sm font-medium text-gray-300 mb-2" %>
              <%= f.association :brand,
                    collection: Brand.all,
                    prompt: "Selecione uma marca",
                    input_html: { class: "w-full px-4 py-3 bg-gray-900/50 border border-gray-700 rounded-lg text-gray-100 focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:border-transparent transition-all" } %>
            </div>

            <div>
              <%= f.label :category, "Categoria", class: "block text-sm font-medium text-gray-300 mb-2" %>
              <%= f.association :category,
                    collection: Category.all,
                    prompt: "Selecione uma categoria",
                    input_html: { class: "w-full px-4 py-3 bg-gray-900/50 border border-gray-700 rounded-lg text-gray-100 focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:border-transparent transition-all" } %>
            </div>
          </div>

          <!-- Serial Number -->
          <div>
            <%= f.label :serie_number, "Número de Série", class: "block text-sm font-medium text-gray-300 mb-2" %>
            <%= f.input_field :serie_number,
                  class: "w-full px-4 py-3 bg-gray-900/50 border border-gray-700 rounded-lg text-gray-100 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:border-transparent transition-all font-mono",
                  placeholder: "SN-XXX-XXX" %>
            <%= f.error :serie_number, class: "mt-1 text-sm text-red-400" %>
          </div>

          <!-- Grid: Prices and Quantity -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div>
              <%= f.label :cost_price, "Preço de Custo", class: "block text-sm font-medium text-gray-300 mb-2" %>
              <%= f.input_field :cost_price,
                    as: :decimal,
                    class: "w-full px-4 py-3 bg-gray-900/50 border border-gray-700 rounded-lg text-gray-100 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:border-transparent transition-all",
                    step: 0.01,
                    placeholder: "0.00" %>
              <%= f.error :cost_price, class: "mt-1 text-sm text-red-400" %>
            </div>

            <div>
              <%= f.label :selling_price, "Preço de Venda", class: "block text-sm font-medium text-gray-300 mb-2" %>
              <%= f.input_field :selling_price,
                    as: :decimal,
                    class: "w-full px-4 py-3 bg-gray-900/50 border border-gray-700 rounded-lg text-gray-100 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:border-transparent transition-all",
                    step: 0.01,
                    placeholder: "0.00" %>
              <%= f.error :selling_price, class: "mt-1 text-sm text-red-400" %>
            </div>

            <div>
              <%= f.label :quantity, "Quantidade", class: "block text-sm font-medium text-gray-300 mb-2" %>
              <%= f.input_field :quantity,
                    as: :integer,
                    class: "w-full px-4 py-3 bg-gray-900/50 border border-gray-700 rounded-lg text-gray-100 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:border-transparent transition-all",
                    placeholder: "0" %>
              <%= f.error :quantity, class: "mt-1 text-sm text-red-400" %>
            </div>
          </div>
        </div>

        <!-- Actions -->
        <div class="flex items-center justify-between mt-8 pt-6 border-t border-gray-700/50">
          <%= link_to products_path, class: "px-6 py-3 bg-gray-700 hover:bg-gray-600 text-white font-medium rounded-lg transition-colors" do %>
            Cancelar
          <% end %>

          <%= f.button :submit, "Atualizar Produto",
                class: "px-6 py-3 bg-gradient-to-r from-yellow-600 to-orange-600 hover:from-yellow-700 hover:to-orange-700 text-white font-medium rounded-lg shadow-lg shadow-yellow-500/30 transition-all duration-300 hover:scale-105" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
