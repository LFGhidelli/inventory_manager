<div class="row justify-content-center">
  <div class="col-md-6">
    <%= form_with model: @product, method: :patch, class: "mb-3 shadow p-3 mb-5 bg-body-tertiary rounded" do |f| %>
      <div class="mb-3">
        <%= f.label :title, class: "form-label" %>
        <%= f.text_field :title, class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= f.label :description, class: "form-label" %>
        <%= f.text_area :description, class: "form-control" %>
      </div>

      <div class="d-flex justify-content-between">
        <%= f.submit "Salvar fornecedor", class: "btn btn-primary" %>
        <%= link_to "Voltar", products_path, class: "btn btn-outline-danger" %>
      </div>
    <% end %>
  </div>
</div>
