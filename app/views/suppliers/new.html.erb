<% content_for :page_title, "Novo Fornecedor" %>
<div class="max-w-3xl mx-auto space-y-6 animate-fade-in">
  <div><%= link_to suppliers_path, class: "inline-flex items-center text-gray-400 hover:text-white transition-colors" do %><i class="bi bi-arrow-left mr-2"></i>Voltar<% end %></div>
  <div class="bg-gray-800/50 backdrop-blur-xl rounded-xl border border-gray-700/50 overflow-hidden">
    <div class="bg-gradient-to-r from-purple-600/20 to-blue-600/20 px-8 py-6 border-b border-gray-700/50">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-lg bg-gradient-to-br from-purple-500 to-blue-600 flex items-center justify-center shadow-lg shadow-purple-500/30"><i class="bi bi-plus-circle text-white text-xl"></i></div>
        <div><h1 class="text-2xl font-bold text-white">Novo Fornecedor</h1><p class="text-sm text-gray-400 mt-1">Adicione um novo fornecedor</p></div>
      </div>
    </div>
    <div class="p-8">
      <%= simple_form_for @supplier do |f| %>
        <%= f.error_notification %>
        <div class="space-y-6">
          <div>
            <%= f.label :name, "Nome", class: "block text-sm font-medium text-gray-300 mb-2" %>
            <%= f.input_field :name, class: "w-full px-4 py-3 bg-gray-900/50 border border-gray-700 rounded-lg text-gray-100 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all", placeholder: "Nome do fornecedor" %>
            <%= f.error :name, class: "mt-1 text-sm text-red-400" %>
          </div>
          <div>
            <%= f.label :description, "Descrição", class: "block text-sm font-medium text-gray-300 mb-2" %>
            <%= f.input_field :description, as: :text, class: "w-full px-4 py-3 bg-gray-900/50 border border-gray-700 rounded-lg text-gray-100 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all", rows: 4, placeholder: "Descreva o fornecedor..." %>
            <%= f.error :description, class: "mt-1 text-sm text-red-400" %>
          </div>
        </div>
        <div class="flex items-center justify-between mt-8 pt-6 border-t border-gray-700/50">
          <%= link_to suppliers_path, class: "px-6 py-3 bg-gray-700 hover:bg-gray-600 text-white font-medium rounded-lg transition-colors" do %>Cancelar<% end %>
          <%= f.button :submit, "Salvar Fornecedor", class: "px-6 py-3 bg-gradient-to-r from-purple-600 to-blue-600 hover:from-purple-700 hover:to-blue-700 text-white font-medium rounded-lg shadow-lg shadow-purple-500/30 transition-all duration-300 hover:scale-105" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
