<div class="row justify-content-center">
  <div class="col-md-6">
    <%= simple_form_for @supplier, html: { class: "mb-3 shadow p-3 mb-5 bg-body-tertiary rounded" } do |f| %>
      <h2>Novo fornecedor</h2>

      <%= f.error_notification %>

      <%= f.input :name,
            label: "Nome",
            input_html: { class: "form-control" } %>

      <%= f.input :description,
            label: "Descrição",
            as: :text,
            input_html: { class: "form-control" } %>

      <div class="d-flex justify-content-between">
        <%= f.button :submit, "Salvar", class: "btn btn-primary" %>
        <%= link_to "Voltar", suppliers_path, class: "btn btn-outline-danger" %>
      </div>
    <% end %>
  </div>
</div>
