<!-- Mobile/Desktop Menu Controller -->
<div data-controller="mobile-menu">
  <!-- Desktop Sidebar -->
  <aside class="w-64 bg-gray-800/50 backdrop-blur-xl border-r border-gray-700/50 hidden lg:flex lg:flex-col">
    <!-- Logo/Brand -->
    <div class="p-6 border-b border-gray-700/50">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-purple-500 to-blue-600 flex items-center justify-center shadow-lg shadow-purple-500/50">
          <i class="bi bi-box-seam text-white text-xl"></i>
        </div>
        <div>
          <h1 class="text-xl font-bold text-white">Inventory</h1>
          <p class="text-xs text-gray-400">Sistema de Gestão</p>
        </div>
      </div>
    </div>

    <!-- Navigation -->
    <%= render "layouts/components/sidebar_nav" %>

    <!-- User Section -->
    <%= render "layouts/components/sidebar_user" %>
  </aside>

  <!-- Mobile Hamburger Button -->
  <button
    data-action="click->mobile-menu#toggle"
    class="lg:hidden fixed top-4 left-4 z-50 w-12 h-12 rounded-lg bg-gray-800/90 backdrop-blur-xl border border-gray-700/50 text-white shadow-lg flex items-center justify-center hover:bg-gray-700 transition-all duration-200"
    aria-label="Toggle menu"
  >
    <i class="bi bi-list text-2xl"></i>
  </button>

  <!-- Mobile Sidebar Overlay -->
  <div
    data-mobile-menu-target="overlay"
    data-action="click->mobile-menu#close"
    class="lg:hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-40 hidden transition-opacity duration-300"
    aria-hidden="true"
  ></div>

  <!-- Mobile Sidebar -->
  <aside
    data-mobile-menu-target="sidebar"
    class="lg:hidden fixed top-0 left-0 bottom-0 w-72 sm:w-80 bg-gray-800/98 backdrop-blur-xl border-r border-gray-700/50 z-50 transform -translate-x-full transition-transform duration-300 ease-in-out flex flex-col shadow-2xl"
    role="dialog"
    aria-label="Mobile navigation menu"
  >
    <!-- Logo/Brand with Close Button -->
    <div class="p-6 border-b border-gray-700/50 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-purple-500 to-blue-600 flex items-center justify-center shadow-lg shadow-purple-500/50">
          <i class="bi bi-box-seam text-white text-xl"></i>
        </div>
        <div>
          <h1 class="text-xl font-bold text-white">Inventory</h1>
          <p class="text-xs text-gray-400">Sistema de Gestão</p>
        </div>
      </div>
      <button
        data-action="click->mobile-menu#close"
        class="text-gray-400 hover:text-white transition-colors p-2 hover:bg-gray-700/50 rounded-lg"
        aria-label="Close menu"
      >
        <i class="bi bi-x-lg text-xl"></i>
      </button>
    </div>

    <!-- Navigation -->
    <%= render "layouts/components/sidebar_nav" %>

    <!-- User Section -->
    <%= render "layouts/components/sidebar_user" %>
  </aside>
</div>
