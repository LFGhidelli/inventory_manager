<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Inventory App" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

    <!-- Tailwind CSS -->
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@2.8.0"></script>

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js" crossorigin="anonymous"></script>
  </head>

  <body class="bg-gradient-to-br from-gray-900 via-purple-900 to-gray-900 min-h-screen">
    <% if user_signed_in? %>
      <!-- Layout com Sidebar para usuários logados -->
      <div class="flex flex-col min-h-screen">
        <div class="flex flex-1">
          <!-- Sidebar -->
          <%= render "layouts/components/sidebar" %>

          <!-- Main Content -->
          <div class="flex-1 flex flex-col">
            <!-- Header -->
            <%= render "layouts/components/header" %>

            <!-- Content Area -->
            <main class="flex-1 overflow-x-hidden overflow-y-auto">
              <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6 lg:py-8">
                <%= yield %>
              </div>
            </main>
          </div>
        </div>

        <!-- Footer - ocupa toda a largura -->
        <%= render "layouts/components/footer" %>
      </div>
    <% else %>
      <!-- Layout para páginas de autenticação (sem sidebar) -->
      <%= yield %>
    <% end %>
  </body>
</html>
