<% content_for :page_title, "Marcas" %>

<div class="space-y-6 animate-fade-in">
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-blue-400">Marcas</h1>
      <p class="mt-1 text-gray-400">Gerencie as marcas dos produtos</p>
    </div>
    <% if current_user.admin? %>
      <%= link_to new_brand_path, class: "inline-flex items-center px-6 py-3 bg-gradient-to-r from-purple-600 to-blue-600 hover:from-purple-700 hover:to-blue-700 text-white font-medium rounded-lg shadow-lg shadow-purple-500/30 transition-all duration-300 hover:scale-105" do %>
        <i class="bi bi-plus-circle mr-2"></i>Nova Marca
      <% end %>
    <% end %>
  </div>

  <div class="bg-gray-800/50 backdrop-blur-xl rounded-xl border border-gray-700/50 p-6">
    <%= form_with url: brands_path, method: :get, class: "flex gap-2" do %>
      <div class="flex-1">
        <%= text_field_tag :query, params[:query], placeholder: "Buscar marca...", class: "w-full px-4 py-3 bg-gray-900/50 border border-gray-700 rounded-lg text-gray-100 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all" %>
      </div>
      <%= submit_tag "Buscar", class: "px-6 py-3 bg-purple-600 hover:bg-purple-700 text-white font-medium rounded-lg transition-colors" %>
    <% end %>
  </div>

  <div class="bg-gray-800/50 backdrop-blur-xl rounded-xl border border-gray-700/50 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="bg-gradient-to-r from-purple-600/20 to-blue-600/20 border-b border-gray-700/50">
            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-300 uppercase tracking-wider">ID</th>
            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-300 uppercase tracking-wider">Nome</th>
            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-300 uppercase tracking-wider">Descrição</th>
            <th class="px-6 py-4 text-center text-xs font-semibold text-gray-300 uppercase tracking-wider">Ações</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-700/50">
          <% @brands.each do |brand| %>
            <tr class="hover:bg-gray-700/30 transition-colors">
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-300"><%= brand.id %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-white"><%= brand.name %></td>
              <td class="px-6 py-4 text-sm text-gray-300"><%= brand.description %></td>
              <td class="px-6 py-4 whitespace-nowrap text-center text-sm">
                <div class="flex items-center justify-center gap-2">
                  <%= link_to brand_path(brand), class: "p-2 bg-blue-600/20 hover:bg-blue-600/40 text-blue-400 rounded-lg transition-colors" do %>
                    <i class="bi bi-eye"></i>
                  <% end %>
                  <% if current_user.admin? %>
                    <%= link_to edit_brand_path(brand), class: "p-2 bg-yellow-600/20 hover:bg-yellow-600/40 text-yellow-400 rounded-lg transition-colors" do %>
                      <i class="bi bi-pencil"></i>
                    <% end %>
                    <%= link_to brand_path(brand), data: { turbo_method: :delete, turbo_confirm: "Tem certeza?" }, class: "p-2 bg-red-600/20 hover:bg-red-600/40 text-red-400 rounded-lg transition-colors" do %>
                      <i class="bi bi-trash"></i>
                    <% end %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="px-6 py-4 border-t border-gray-700/50">
      <div class="flex items-center justify-center">
        <%== pagy_tailwind_nav(@pagy) %>
      </div>
    </div>
  </div>
</div>
