
<% flash.each do |type, msg| %>
  <div class="alert alert-info">
    <%= msg %>
  </div>
<% end %>

<div class="d-flex justify-content-between">
  <%= form_with url: brands_path, method: :get, class: "d-flex" do %>
    <div class="input-group">
      <%= text_field_tag :query, params[:query], placeholder: "Search", class: "form-control" %>
      <%= submit_tag "Search", class: "btn btn-outline-success" %>
    </div>
  <% end %>
</form>


<%= link_to new_brand_path, class: "btn btn-success" do %>
  <i class="bi bi-plus"></i>
  <span>Nova marca</span>
<% end%>
</div>

<table class="table table-striped">
  <thead>
    <tr>
      <th scope="col">id</th>
      <th scope="col">Nome</th>
      <th scope="col">Descrição</th>
      <th scope="col">Ações</th>
    </tr>
  </thead>
  <tbody>
    <% @brands.each do |brand| %>
      <tr>
        <th scope="row"><%= brand.id %></th>
        <td><%= brand.name %></td>
        <td><%= brand.description %></td>
        <td>
          <%= link_to brand_path(brand), class:"btn btn-outline-info" do %>
            <i class="bi bi-eye"></i>
          <% end%>

          <%= link_to edit_brand_path(brand), class:"btn btn-outline-warning" do %>
            <i class="bi bi-pencil"></i>
          <% end%>

          <%= link_to brand_path(brand), data: { turbo_method: :delete }, class:"btn btn-outline-danger" do %>
            <i class="bi bi-trash"></i>
          <% end%> 
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

