<% flash.each do |type, msg| %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <%= msg %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% end %>

<div class="d-flex justify-content-between mb-4">
  <%= form_with url: categories_path, method: :get, class: "d-flex" do %>
    <div class="input-group">
      <%= text_field_tag :query, params[:query], placeholder: "Search", class: "form-control" %>
      <%= submit_tag "Search", class: "btn btn-outline-success" %>
    </div>
  <% end %>

  
  <% if current_user.admin? %>
    <%= link_to new_category_path, class: "btn btn-success" do %>
      <i class="bi bi-plus"></i>
      <span>Nova categoria</span>
    <% end%>
  <% end %>
</div>

<div class="table-responsive">
  <table class="table table-striped table-bordered align-middle">
    <thead class="text-center">
      <tr>
        <th scope="col">ID</th>
        <th scope="col">Nome</th>
        <th scope="col">Descrição</th>
        <th scope="col" class="w-25">Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @categories.each do |category| %>
        <tr>
          <th scope="row"><%= category.id %></th>
          <td><%= category.name %></td>
          <td><%= category.description %></td>
          <td class="d-flex justify-content-center gap-2">
            <%= link_to category_path(category), class:"btn btn-outline-info btn-sm" do %>
              <i class="bi bi-eye"></i>
            <% end %>

            <% if current_user.admin? %>
              <%= link_to edit_category_path(category), class:"btn btn-outline-warning btn-sm" do %>
                <i class="bi bi-pencil"></i>
              <% end %>

              <%= link_to category_path(category), 
                          data: { turbo_method: :delete, confirm: "Are you sure?" }, 
                          class:"btn btn-outline-danger btn-sm" do %>
                <i class="bi bi-trash"></i>
              <% end %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <div class="pag-bar mt-2 mb-2 d-flex justify-content-center">
    <%== pagy_bootstrap_nav(@pagy) %>
  </div>
</div>

