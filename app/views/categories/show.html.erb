<div class="container mt-4">
  <h3 class="display-6">Detalhes da categoria</h3>

  <div class="card">
    <div class="card-body">
      <h3 class="card-title"><%= @category.name %></h3>
      <p class="card-text"><%= @category.description %></p>

    </div>
  </div>
  <%= link_to "Voltar", categories_path, class: "btn btn-outline-danger mt-4" %>
</div>
