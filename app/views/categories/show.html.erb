<% content_for :page_title, "Detalhes da Categoria" %>
<div class="max-w-4xl mx-auto space-y-6 animate-fade-in">
  <div><%= link_to categories_path, class: "inline-flex items-center text-gray-400 hover:text-white transition-colors" do %><i class="bi bi-arrow-left mr-2"></i>Voltar<% end %></div>
  <div class="bg-gray-800/50 backdrop-blur-xl rounded-xl border border-gray-700/50 overflow-hidden">
    <div class="bg-gradient-to-r from-purple-600/20 to-blue-600/20 px-8 py-6 border-b border-gray-700/50">
      <div class="flex items-center justify-between"><div><h1 class="text-3xl font-bold text-white"><%= @category.name %></h1><p class="mt-1 text-gray-400">ID: #<%= @category.id %></p></div><div class="w-16 h-16 rounded-xl bg-gradient-to-br from-purple-500 to-blue-600 flex items-center justify-center shadow-lg shadow-purple-500/30"><i class="bi bi-tags text-white text-3xl"></i></div></div>
    </div>
    <div class="p-8 space-y-6">
      <div><label class="block text-sm font-medium text-gray-400 mb-2">Descrição</label><p class="text-white bg-gray-900/50 rounded-lg p-4 border border-gray-700"><%= @category.description || "Sem descrição" %></p></div>
    </div>
    <div class="bg-gray-900/30 px-8 py-4 border-t border-gray-700/50 flex items-center justify-between"><div class="text-xs text-gray-500">Criado em <%= l(@category.created_at, format: :long) %></div><% if current_user.admin? %><div class="flex gap-2"><%= link_to edit_category_path(@category), class: "inline-flex items-center px-4 py-2 bg-yellow-600/20 hover:bg-yellow-600/40 text-yellow-400 rounded-lg transition-colors" do %><i class="bi bi-pencil mr-2"></i>Editar<% end %><%= link_to category_path(@category), data: { turbo_method: :delete, turbo_confirm: "Tem certeza?" }, class: "inline-flex items-center px-4 py-2 bg-red-600/20 hover:bg-red-600/40 text-red-400 rounded-lg transition-colors" do %><i class="bi bi-trash mr-2"></i>Excluir<% end %></div><% end %></div>
  </div>
</div>
