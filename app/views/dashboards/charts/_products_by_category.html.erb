<!-- Products by Category Chart -->
<div class="bg-gray-800/50 backdrop-blur-xl rounded-xl border border-gray-700/50 p-4 sm:p-6 hover:border-blue-500/30 transition-all duration-300 animate-fade-in" style="animation-delay: 1s;">
  <div class="flex items-center justify-between mb-4 sm:mb-6">
    <div class="flex-1 min-w-0">
      <h3 class="text-base sm:text-lg font-semibold text-white">Produtos por Categoria</h3>
      <p class="text-xs sm:text-sm text-gray-400 mt-1 truncate">Distribuição de produtos</p>
    </div>
    <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-blue-500 to-cyan-600 flex items-center justify-center shrink-0 ml-2">
      <i class="bi bi-tags text-white"></i>
    </div>
  </div>
  <div class="relative h-64 sm:h-80">
    <canvas
      id="productsByCategory"
      data-product-category="<%= Category.product_by_category.to_json %>">
    </canvas>
  </div>
</div>
