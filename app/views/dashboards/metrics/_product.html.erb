<!-- Product Metrics -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
  <!-- Total Quantity -->
  <div class="bg-gray-800/50 backdrop-blur-xl rounded-xl border border-blue-500/30 p-6 hover:border-blue-500/50 transition-all duration-300 hover:shadow-xl hover:shadow-blue-500/20 animate-fade-in">
    <div class="flex items-center justify-between">
      <div class="flex-1">
        <p class="text-sm font-medium text-gray-400 mb-1">Quantidade de Produtos</p>
        <h3 class="text-3xl font-bold text-white"><%= Product.total_quantity %></h3>
        <p class="text-xs text-blue-400 mt-2">
          <i class="bi bi-box-seam mr-1"></i>
          Total em estoque
        </p>
      </div>
      <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-blue-500 to-blue-600 flex items-center justify-center shadow-lg shadow-blue-500/30">
        <i class="bi bi-box-seam text-white text-2xl"></i>
      </div>
    </div>
  </div>

  <!-- Cost Price -->
  <div class="bg-gray-800/50 backdrop-blur-xl rounded-xl border border-red-500/30 p-6 hover:border-red-500/50 transition-all duration-300 hover:shadow-xl hover:shadow-red-500/20 animate-fade-in" style="animation-delay: 0.1s;">
    <div class="flex items-center justify-between">
      <div class="flex-1">
        <p class="text-sm font-medium text-gray-400 mb-1">Custo de Estoque</p>
        <h3 class="text-2xl font-bold text-white">
          <%= number_to_currency(Product.total_cost_price, unit: "R$", delimiter: ".", separator: ",", precision: 2) %>
        </h3>
        <p class="text-xs text-red-400 mt-2">
          <i class="bi bi-currency-dollar mr-1"></i>
          Investimento total
        </p>
      </div>
      <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-red-500 to-red-600 flex items-center justify-center shadow-lg shadow-red-500/30">
        <i class="bi bi-currency-dollar text-white text-2xl"></i>
      </div>
    </div>
  </div>

  <!-- Inventory Value -->
  <div class="bg-gray-800/50 backdrop-blur-xl rounded-xl border border-green-500/30 p-6 hover:border-green-500/50 transition-all duration-300 hover:shadow-xl hover:shadow-green-500/20 animate-fade-in" style="animation-delay: 0.2s;">
    <div class="flex items-center justify-between">
      <div class="flex-1">
        <p class="text-sm font-medium text-gray-400 mb-1">Valor do Estoque</p>
        <h3 class="text-2xl font-bold text-white">
          <%= number_to_currency(Product.inventory_value, unit: "R$", delimiter: ".", separator: ",", precision: 2) %>
        </h3>
        <p class="text-xs text-green-400 mt-2">
          <i class="bi bi-graph-up mr-1"></i>
          Valor potencial
        </p>
      </div>
      <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-green-500 to-green-600 flex items-center justify-center shadow-lg shadow-green-500/30">
        <i class="bi bi-cash-stack text-white text-2xl"></i>
      </div>
    </div>
  </div>

  <!-- Inventory Profit -->
  <div class="bg-gray-800/50 backdrop-blur-xl rounded-xl border border-yellow-500/30 p-6 hover:border-yellow-500/50 transition-all duration-300 hover:shadow-xl hover:shadow-yellow-500/20 animate-fade-in" style="animation-delay: 0.3s;">
    <div class="flex items-center justify-between">
      <div class="flex-1">
        <p class="text-sm font-medium text-gray-400 mb-1">Lucro de Estoque</p>
        <h3 class="text-2xl font-bold text-white">
          <%= number_to_currency(Product.inventory_profit, unit: "R$", delimiter: ".", separator: ",", precision: 2) %>
        </h3>
        <p class="text-xs text-yellow-400 mt-2">
          <i class="bi bi-trophy mr-1"></i>
          Lucro potencial
        </p>
      </div>
      <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-yellow-500 to-yellow-600 flex items-center justify-center shadow-lg shadow-yellow-500/30">
        <i class="bi bi-trophy text-white text-2xl"></i>
      </div>
    </div>
  </div>
</div>
