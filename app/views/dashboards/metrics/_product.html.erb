<div class="container mt-4">
  <div class="row text-center">

    <div class="col-md-3">
      <div class="card text-white border border-primary mb-3 shadow">
        <div class="card-body">
          <h6 class="card-title">Quantidade de produtos</h6>
          <h3 class="card-text"><%= Product.total_quantity %></h3>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card text-white border border-danger mb-3 shadow">
        <div class="card-body">
          <h6 class="card-title">Custo de estoque</h6>
          <h3 class="card-text"><%= number_to_currency(Product.total_cost_price, unit: "R$", delimiter: ".", separator: ",", precision: 2) %></h3>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card text-white border border-success mb-3 shadow">
        <div class="card-body">
          <h6 class="card-title">Valor do estoque</h6>
          <h3 class="card-text"><%= number_to_currency(Product.inventory_value, unit: "R$", delimiter: ".", separator: ",", precision: 2) %></h3>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card text-white border border-warning mb-3 shadow">
        <div class="card-body">
          <h6 class="card-title">Lucro de estoque</h6>
          <h3 class="card-text"><%= number_to_currency(Product.inventory_profit, unit: "R$", delimiter: ".", separator: ",", precision: 2) %></h3>
        </div>
      </div>
    </div>

  </div>
</div>
