<!-- Sales Metrics -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-6">
  <!-- Total Sales -->
  <div class="bg-gray-800/50 backdrop-blur-xl rounded-xl border border-purple-500/30 p-6 hover:border-purple-500/50 transition-all duration-300 hover:shadow-xl hover:shadow-purple-500/20 animate-fade-in" style="animation-delay: 0.4s;">
    <div class="flex items-center justify-between">
      <div class="flex-1">
        <p class="text-sm font-medium text-gray-400 mb-1">Quantidade de Vendas</p>
        <h3 class="text-3xl font-bold text-white"><%= Outflow.total_sales %></h3>
        <p class="text-xs text-purple-400 mt-2">
          <i class="bi bi-cart-check mr-1"></i>
          Total de transações
        </p>
      </div>
      <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-purple-500 to-purple-600 flex items-center justify-center shadow-lg shadow-purple-500/30">
        <i class="bi bi-cart-check text-white text-2xl"></i>
      </div>
    </div>
  </div>

  <!-- Items Sold -->
  <div class="bg-gray-800/50 backdrop-blur-xl rounded-xl border border-pink-500/30 p-6 hover:border-pink-500/50 transition-all duration-300 hover:shadow-xl hover:shadow-pink-500/20 animate-fade-in" style="animation-delay: 0.5s;">
    <div class="flex items-center justify-between">
      <div class="flex-1">
        <p class="text-sm font-medium text-gray-400 mb-1">Produtos Vendidos</p>
        <h3 class="text-3xl font-bold text-white"><%= Outflow.total_items_sold %></h3>
        <p class="text-xs text-pink-400 mt-2">
          <i class="bi bi-box2 mr-1"></i>
          Unidades vendidas
        </p>
      </div>
      <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-pink-500 to-pink-600 flex items-center justify-center shadow-lg shadow-pink-500/30">
        <i class="bi bi-box2 text-white text-2xl"></i>
      </div>
    </div>
  </div>

  <!-- Amount Sold -->
  <div class="bg-gray-800/50 backdrop-blur-xl rounded-xl border border-cyan-500/30 p-6 hover:border-cyan-500/50 transition-all duration-300 hover:shadow-xl hover:shadow-cyan-500/20 animate-fade-in" style="animation-delay: 0.6s;">
    <div class="flex items-center justify-between">
      <div class="flex-1">
        <p class="text-sm font-medium text-gray-400 mb-1">Valor das Vendas</p>
        <h3 class="text-2xl font-bold text-white">
          <%= number_to_currency(Outflow.amount_sold, unit: "R$", delimiter: ".", separator: ",", precision: 2) %>
        </h3>
        <p class="text-xs text-cyan-400 mt-2">
          <i class="bi bi-cash-coin mr-1"></i>
          Receita total
        </p>
      </div>
      <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-cyan-500 to-cyan-600 flex items-center justify-center shadow-lg shadow-cyan-500/30">
        <i class="bi bi-cash-coin text-white text-2xl"></i>
      </div>
    </div>
  </div>

  <!-- Sales Profit -->
  <div class="bg-gray-800/50 backdrop-blur-xl rounded-xl border border-emerald-500/30 p-6 hover:border-emerald-500/50 transition-all duration-300 hover:shadow-xl hover:shadow-emerald-500/20 animate-fade-in" style="animation-delay: 0.7s;">
    <div class="flex items-center justify-between">
      <div class="flex-1">
        <p class="text-sm font-medium text-gray-400 mb-1">Lucro das Vendas</p>
        <h3 class="text-2xl font-bold text-white">
          <%= number_to_currency(Outflow.profit, unit: "R$", delimiter: ".", separator: ",", precision: 2) %>
        </h3>
        <p class="text-xs text-emerald-400 mt-2">
          <i class="bi bi-graph-up-arrow mr-1"></i>
          Lucro realizado
        </p>
      </div>
      <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-emerald-500 to-emerald-600 flex items-center justify-center shadow-lg shadow-emerald-500/30">
        <i class="bi bi-graph-up-arrow text-white text-2xl"></i>
      </div>
    </div>
  </div>
</div>
