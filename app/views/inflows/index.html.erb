<% flash.each do |type, msg| %>
  <% bootstrap_class =
      case type.to_sym
      when :notice then "success"
      when :alert  then "danger"
      else "info"
      end %>

  <div class="alert alert-<%= bootstrap_class %> alert-dismissible fade show" role="alert">
    <%= msg %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% end %>

<div class="d-flex justify-content-between mb-4">
  <%= form_with url: inflows_path, method: :get, class: "d-flex" do %>
    <div class="input-group">
      <%= text_field_tag :query, params[:query], placeholder: "Search", class: "form-control" %>
      <%= submit_tag "Search", class: "btn btn-outline-success" %>
    </div>
  <% end %>

  <%= link_to new_inflow_path, class: "btn btn-success d-flex align-items-center gap-1" do %>
    <i class="bi bi-plus"></i>
    <span>Nova Entrada</span>
  <% end %>
</div>

<div class="table-responsive">
  <table class="table table-striped table-bordered align-middle">
    <thead class="text-center">
      <tr>
        <th scope="col">ID</th>
        <th scope="col">Produto</th>
        <th scope="col">Fornecedor</th>
        <th scope="col">Quantidade</th>
        <th scope="col">Data da entrada</th>
        <th scope="col">Descrição</th>
        <th scope="col">Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @inflows.each do |inflow| %>
        <tr>
          <th scope="row"><%= inflow.id %></th>
          <td><%= inflow.product.title %></td>
          <td><%= inflow.supplier.name %></td>
          <td><%= inflow.quantity %></td>
          <td><%= inflow.created_at.strftime('%d/%m/%y') %></td>
          <td><%= inflow.description %></td>
          <td class="d-flex justify-content-center gap-2">
            <%= link_to inflow_path(inflow), class: "btn btn-outline-info btn-sm" do %>
              <i class="bi bi-eye"></i>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="pag-bar mt-2 mb-2 d-flex justify-content-center">
    <%= raw pagy_bootstrap_nav(@pagy) %>
  </div>
</div>
