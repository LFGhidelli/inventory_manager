<% content_for :page_title, "Detalhes da Entrada" %>
<div class="max-w-4xl mx-auto space-y-6 animate-fade-in">
  <div><%= link_to inflows_path, class: "inline-flex items-center text-gray-400 hover:text-white transition-colors" do %><i class="bi bi-arrow-left mr-2"></i>Voltar<% end %></div>
  <div class="bg-gray-800/50 backdrop-blur-xl rounded-xl border border-gray-700/50 overflow-hidden">
    <div class="bg-gradient-to-r from-green-600/20 to-emerald-600/20 px-8 py-6 border-b border-gray-700/50">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-3xl font-bold text-white"><%= @inflow.product.title %></h1>
          <p class="mt-1 text-gray-400">Entrada #<%= @inflow.id %></p>
        </div>
        <div class="w-16 h-16 rounded-xl bg-gradient-to-br from-green-500 to-emerald-600 flex items-center justify-center shadow-lg shadow-green-500/30">
          <i class="bi bi-arrow-down-circle text-white text-3xl"></i>
        </div>
      </div>
    </div>

    <div class="p-8 space-y-6">
      <div class="grid md:grid-cols-2 gap-6">
        <div>
          <label class="block text-sm font-medium text-gray-400 mb-2">Produto</label>
          <p class="text-white bg-gray-900/50 rounded-lg p-4 border border-gray-700"><%= @inflow.product.title %></p>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-400 mb-2">Fornecedor</label>
          <p class="text-white bg-gray-900/50 rounded-lg p-4 border border-gray-700"><%= @inflow.supplier.name %></p>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-400 mb-2">Quantidade</label>
          <p class="text-white bg-gray-900/50 rounded-lg p-4 border border-gray-700">
            <span class="inline-flex items-center px-4 py-2 bg-green-600/20 text-green-400 rounded-lg font-bold">
              +<%= @inflow.quantity %>
            </span>
          </p>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-400 mb-2">Data da Entrada</label>
          <p class="text-white bg-gray-900/50 rounded-lg p-4 border border-gray-700"><%= l(@inflow.created_at, format: :long) %></p>
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-400 mb-2">Descrição</label>
        <p class="text-white bg-gray-900/50 rounded-lg p-4 border border-gray-700"><%= @inflow.description || "Sem descrição" %></p>
      </div>
    </div>

    <div class="bg-gray-900/30 px-8 py-4 border-t border-gray-700/50">
      <div class="text-xs text-gray-500">Registrado em <%= l(@inflow.created_at, format: :long) %></div>
    </div>
  </div>
</div>
