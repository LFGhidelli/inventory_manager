<div class="container mt-4">
  <h3 class="display-6 mb-3">Detalhes</h3>

  <div class="card shadow-sm">
    <div class="card-body">
      <h4 class="card-title mb-3"><%= @inflow.product.title %></h4>

      <ul class="list-group list-group-flush mb-3">
        <li class="list-group-item d-flex justify-content-between">
          <strong>Fornecedor:</strong>
          <span><%= @inflow.supplier.name %></span>
        </li>
        <li class="list-group-item d-flex justify-content-between">
          <strong>Quantidade:</strong>
          <span><%= @inflow.quantity %></span>
        </li>
      </ul>

      <% if @inflow.description.present? %>
        <p class="card-text"><%= @inflow.description %></p>
      <% end %>
    </div>
  </div>

  <%= link_to "Voltar", inflows_path, class: "btn btn-outline-danger mt-4" %>
</div>
